TS_TOPDIR="${0%/*}/../.."
. "$TS_TOPDIR"/functions.sh

ts_init "$*"

ts_check_prog "tar"
ts_check_prog "gzip"
ts_check_test_command "$TS_CMD_LSCPU"

for dump in $(find "$TS_SELF"/dumps/ -maxdepth 1 -name "*.tar.gz" | sort); do
	name=$(basename $dump .tar.gz)
	dumpdir="$TS_OUTDIR/dumps"

	ts_init_subtest $name
	mkdir -p $dumpdir

	tar --no-same-owner -C $dumpdir -zxf $dump

	# Architecture information is not applicable with -s.
	"${TS_CMD_LSCPU}" --sysroot "${dumpdir}/${name}" | \
		grep -v "Architecture" >> "$TS_OUTPUT" 2>> "$TS_ERRLOG"

	echo >>"$TS_OUTPUT"

	"${TS_CMD_LSCPU}" --parse --sysroot "${dumpdir}/${name}" \
		 >> "$TS_OUTPUT" 2>> "$TS_ERRLOG"

	echo >>"$TS_OUTPUT"

	"${TS_CMD_LSCPU}" --parse --physical --sysroot "${dumpdir}/${name}" \
		 >> "$TS_OUTPUT" 2>> "$TS_ERRLOG"

	if [[ ! -e "${dumpdir}/${name}/sys/kernel/cpu_byteorder" ]]; then
		# LE/BE depends on binary if we can't read it from the dump
		sed -i -e '/Byte Order:.*/d' "$TS_OUTPUT"
	fi

	ts_finalize_subtest
done

# A malformed CPU list used to leave the caller-visible output pointer
# referring to memory already released by ul_path_cpuparse().  lscpu then
# released the same allocation again during ordinary context cleanup.  Keep
# this fixture bounded to 16 CPUs so the affected allocation path is stable.
malformed_root="$TS_OUTDIR/malformed-cpuset-root"
rm -rf "$malformed_root"
mkdir -p \
	"$malformed_root/proc" \
	"$malformed_root/sys/devices/system/cpu" \
	"$malformed_root/sys/devices/system/node/node0"
cp /proc/cpuinfo "$malformed_root/proc/cpuinfo"
printf '15\n' >"$malformed_root/sys/devices/system/cpu/kernel_max"
printf '0-15\n' >"$malformed_root/sys/devices/system/cpu/possible"
printf '0-15\n' >"$malformed_root/sys/devices/system/cpu/present"
printf '5,12-%%\n' >"$malformed_root/sys/devices/system/cpu/online"
printf '0000ffff\n' >"$malformed_root/sys/devices/system/node/node0/cpumap"

for mode in text json; do
	ts_init_subtest "malformed-cpuset-$mode"
	args=("$TS_CMD_LSCPU" --sysroot "$malformed_root")
	[[ "$mode" == text ]] || args+=(--json)

	if ! (ulimit -c 0; "${args[@]}") >/dev/null 2>&1; then
		ts_failed "lscpu failed after malformed cpuset input ($mode)"
	fi

	ts_finalize_subtest
done
rm -rf "$malformed_root"

ts_finalize
